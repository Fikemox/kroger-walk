# Copy to .dev.vars for `npm run dev`. In production, set each one with `npx wrangler secret put NAME`.
KROGER_CLIENT_ID=your-app-client-id
KROGER_CLIENT_SECRET=your-app-client-secret
# any long random string; changing it signs everyone out
SESSION_KEY=replace-with-32-plus-random-characters
# optional: shared password friends type once to get in (leave unset to skip the gate)
SITE_PASSWORD=pick-something-friends-can-remember
# local dev only (never set in production): wrangler dev rewrites requests to the production host
DEV_ORIGIN=http://localhost:8642
